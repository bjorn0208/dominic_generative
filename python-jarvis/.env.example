# Chave da API Groq (obrigatória): https://console.groq.com/keys
GROQ_API_KEY=

# Modelo de conversa (padrão: llama-3.1-8b-instant)
JARVIS_MODEL=llama-3.1-8b-instant

# Palavras que acordam o assistente (separadas por vírgula)
JARVIS_WAKE_WORDS=dominic,jarvis

# Voz do Edge-TTS (pt-BR-FranciscaNeural ou pt-BR-AntonioNeural)
JARVIS_TTS_VOICE=pt-BR-FranciscaNeural

# Velocidade da fala (ex.: +8%, -5%)
JARVIS_TTS_RATE=+8%
